{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "outDir": "./dist",
    "skipLibCheck": true,
    "paths": {
      "@res": [
        "./resources/index"
      ],
      "@res/*": [
        "./resources/*"
      ],
      "@sst/platform/*": [
        "./.sst/platform/src/*"
      ],
      "@webiai/sdk.infra/*": [
        "./.sst/webiai/dist/*"
      ],
      "@dep:cloud.core": [
        "../core/shared/index"
      ],
      "@dep:cloud.core/*": [
        "../core/shared/*"
      ],
      "@res:cloud.core": [
        "../core/resources/index"
      ],
      "@res:cloud.core/*": [
        "../core/resources/*"
      ]
    }
  },
  "include": [
    "infra/**/*",
    "shared/**/*",
    "resources/**/*",
    "sst.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".sst",
    "modules"
  ]
}
