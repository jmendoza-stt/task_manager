{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "paths": {
      "@res": [
        "./resources/index"
      ],
      "@res/*": [
        "./resources/*"
      ],
      "@sst/platform/*": [
        "./.sst/platform/src/*"
      ],
      "@webiai/sdk.infra/*": [
        "./.sst/webiai/dist/*"
      ],
      "@dep:cloud.core": [
        "../core/shared/index"
      ],
      "@dep:cloud.core/*": [
        "../core/shared/*"
      ],
      "@res:cloud.core": [
        "../core/resources/index"
      ],
      "@res:cloud.core/*": [
        "../core/resources/*"
      ]
    }
  },
  "include": [
    "resources/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
