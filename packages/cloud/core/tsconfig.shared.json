{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "paths": {
      "@sst/platform/*": [
        "./.sst/platform/src/*"
      ],
      "@webiai/sdk.infra/*": [
        "./.sst/webiai/dist/*"
      ]
    }
  },
  "include": [
    "shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
